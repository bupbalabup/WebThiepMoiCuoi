# Chỉ dùng cho `npx wrangler dev`. Sao chép thành .dev.vars và không commit file thật.
GOOGLE_CLIENT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_LOCAL_TEST_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace-with-test-sheet-id
GOOGLE_RSVP_TAB="Phúc đáp"
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8788,http://localhost:5173
